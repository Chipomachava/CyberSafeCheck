<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp">

    <!-- Small Gray All-Caps Category Badge -->
    <TextView
        android:id="@+id/risk_category_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/text_category"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Question Text -->
    <TextView
        android:id="@+id/risk_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_question"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/risk_switch"
        app:layout_constraintTop_toBottomOf="@id/risk_category_badge" />

    <!-- Pill Switch -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/risk_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/white"
        app:trackTint="@color/brand_blue"
        app:trackDecorationTint="@color/brand_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/row_divider" />

    <!-- Subtle bottom divider between list rows -->
    <View
        android:id="@+id/row_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/risk_question" />

</androidx.constraintlayout.widget.ConstraintLayout>